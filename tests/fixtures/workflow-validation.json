            { "id": "e2", "source": { "nodeId": "step_1", "portId": "stem:vocals" }, "target": { "nodeId": "step_2", "portId": "input" } },
            { "id": "e3", "source": { "nodeId": "input", "portId": "audio" }, "target": { "nodeId": "step_2", "portId": "input" } },
            { "id": "e4", "source": { "nodeId": "step_2", "portId": "stem:vocals" }, "target": { "nodeId": "save", "portId": "save:step_2.vocals" } }
          ]
