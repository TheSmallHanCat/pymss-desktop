    {
      "name": "an ensemble with unconnected inputs is rejected",
      "expect": { "ts": "utility_input_missing", "python": "utility_input_missing" },
      "definition": {
        "version": 2,
        "kind": "pymss-studio-graph",
        "defaults": { "device": "auto", "output_format": "wav", "model_dir": null, "inference_params": { "normalize": false } },
