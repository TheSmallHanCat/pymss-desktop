            { "id": "join", "type": "audio_ensemble", "position": { "x": 700, "y": 400 }, "data": { "inputCount": 2, "ensembleType": "avg_wave", "weights": [1, 1], "inputs": ["", ""] } },
            { "id": "save", "type": "save_outputs", "position": { "x": 1100, "y": 192 }, "data": { "outputs": { "utility:join": "ensemble" } } }
          ],
          "edges": [
