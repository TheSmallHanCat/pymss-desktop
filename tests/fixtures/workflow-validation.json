            { "id": "save", "type": "save_outputs", "position": { "x": 900, "y": 192 }, "data": { "outputs": { "step_1.drums": "drums" } } }
          ],
          "edges": [
            { "id": "e1", "source": { "nodeId": "input", "portId": "audio" }, "target": { "nodeId": "step_1", "portId": "input" } },
            { "id": "e2", "source": { "nodeId": "step_1", "portId": "stem:drums" }, "target": { "nodeId": "save", "portId": "save:step_1.drums" } }
          ]
        }
      }
    },
